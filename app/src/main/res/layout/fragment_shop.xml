<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".ui.ShopFragment">

    <!-- AppBar Layout para mantener la cabecera fija -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_light"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título Principal -->
            <TextView
                android:id="@+id/tv_shop_title"
                style="@style/TextAppearance.MiniCientificos.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tienda Oficial"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tv_shop_subtitle"
                style="@style/TextAppearance.MiniCientificos.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lleva la ciencia a casa con nuestros increíbles productos" />

            <!-- Barra de Búsqueda -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_search_shop"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                app:boxCornerRadiusBottomEnd="26dp"
                app:boxCornerRadiusBottomStart="26dp"
                app:boxCornerRadiusTopEnd="26dp"
                app:boxCornerRadiusTopStart="26dp"
                app:boxStrokeColor="@color/pc_blue"
                app:endIconMode="clear_text"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/pc_navy">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search_shop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/nunito"
                    android:hint="Buscar productos, kits, accesorios..."
                    android:inputType="text"
                    android:padding="0dp"
                    android:textColor="@color/pc_navy"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Filtros Rápidos (Chips) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_shop_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_todos"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_peluches"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peluches" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_accesorios"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accesorios" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_ropa"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ropa" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_papeleria"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Papelería" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <!-- Contador de resultados -->
            <TextView
                android:id="@+id/tv_resultados_count"
                style="@style/TextAppearance.MiniCientificos.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="17 productos encontrados"
                android:textStyle="bold" />

            <!-- Selector de Ordenación (Simulado con un TextView clicable por ahora) -->
            <TextView
                android:id="@+id/tv_ordenar"
                style="@style/TextAppearance.MiniCientificos.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ordenar por ▼"
                android:textColor="@color/pc_blue"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido Principal: Grilla de Productos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_productos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="8dp"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <LinearLayout
        android:id="@+id/layout_empty_state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <include
            android:id="@+id/layout_empty_state"
            layout="@layout/view_empty_state" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>