<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card_rounded"
    android:backgroundTint="@color/white"
    android:paddingTop="12dp">

    <!-- Drag Handle Indicator -->
    <View
        android:id="@+id/v_drag_handle_cart"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_badge_rounded"
        android:backgroundTint="@color/card_stroke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cabecera Carrito -->
    <LinearLayout
        android:id="@+id/ll_cart_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_m"
        app:layout_constraintTop_toBottomOf="@id/v_drag_handle_cart">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/fredoka"
            android:text="Tu Carrito Científico 🛒"
            android:textColor="@color/navy_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cart_total_items_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_s"
            android:fontFamily="@font/poppins"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="3 artículos" />

        <ImageButton
            android:id="@+id/btn_close_cart"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:id="@+id/v_divider_cart_header"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke"
        app:layout_constraintTop_toBottomOf="@id/ll_cart_header" />

    <!-- Estado Vacío -->
    <LinearLayout
        android:id="@+id/ll_cart_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_divider_cart_footer"
        app:layout_constraintTop_toBottomOf="@id/v_divider_cart_header">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_shopping_cart"
            app:tint="@color/text_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/fredoka"
            android:text="Tu carrito espacial está vacío"
            android:textColor="@color/navy_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="¡Explora nuestros kits científicos y empieza tu aventura!"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Lista de Productos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_cart_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHeight_max="300dp"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/spacing_s"
        app:layout_constraintBottom_toTopOf="@id/til_cart_notes"
        app:layout_constraintTop_toBottomOf="@id/v_divider_cart_header"
        tools:listitem="@layout/item_cart_product" />

    <!-- Notas -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_cart_notes"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:layout_marginTop="@dimen/spacing_s"
        android:layout_marginBottom="@dimen/spacing_m"
        app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius"
        app:boxCornerRadiusBottomStart="@dimen/card_corner_radius"
        app:boxCornerRadiusTopEnd="@dimen/card_corner_radius"
        app:boxCornerRadiusTopStart="@dimen/card_corner_radius"
        app:boxStrokeColor="@color/primary_blue"
        app:layout_constraintBottom_toTopOf="@id/v_divider_cart_footer">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_cart_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:hint="Notas especiales o dedicatoria (Opcional)"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <View
        android:id="@+id/v_divider_cart_footer"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke"
        app:layout_constraintBottom_toTopOf="@id/ll_cart_summary" />

    <!-- Resumen y Pago -->
    <LinearLayout
        android:id="@+id/ll_cart_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_light"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins"
                android:text="Subtotal"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_cart_subtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="S/ 195.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins"
                android:text="Envío"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="A coordinar"
                android:textColor="@color/primary_blue"
                android:textSize="14sp"
                android:textStyle="italic" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/fredoka"
                android:text="TOTAL A PAGAR"
                android:textColor="@color/navy_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cart_total_final"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka"
                android:textColor="@color/navy_blue"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="S/ 195.00" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cart_checkout_whatsapp"
            style="@style/Widget.MiniCientificos.Button.WhatsApp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/spacing_l"
            android:fontFamily="@font/fredoka"
            android:text="PEDIR POR WHATSAPP 💬"
            android:textSize="16sp"
            app:cornerRadius="@dimen/button_corner_radius" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>